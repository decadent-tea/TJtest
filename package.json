{
  "name": "web-health-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "check": "tsc --noEmit",
    "verify": "tsx scripts/verify.ts",
    "verify:hover": "tsx scripts/verify-hover.ts",
    "verify:quality": "tsx scripts/verify-quality.ts",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "verify:ai-client": "tsx scripts/verify-ai-client.ts",
    "verify:fixes": "tsx scripts/verify-fixes.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "next-themes": "^0.4.6",
    "playwright": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  }
